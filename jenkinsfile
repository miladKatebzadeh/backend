pipeline {
    agent any

    environment{
        VENV=".venv"
        APP_NAME = 'opshubbackend'
        HOST_PORT = '3000'
        CONTAINER_PORT = '3000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                python3 -m venv $VENV
                . $VENV/bin/activate
                pip install -r requirements.txt
                pip install pytest
                pip install gunicorn
                pip list
                '''
            }
        }
       
        stage('Build Docker Image') {
            steps {
                // ساخت ایمیج جدید با تگ شماره بیلد جنکینز
                sh "docker build -t ${APP_NAME}:${BUILD_NUMBER} ."
                sh "docker tag ${APP_NAME}:${BUILD_NUMBER} ${APP_NAME}:latest"
            }
        }

        stage('Deploy Container') {
            steps {
                // توقف و حذف کانتینر قبلی (در صورت وجود) و اجرای کانتینر جدید
                sh """
                    docker stop ${APP_NAME} || true
                    docker rm ${APP_NAME} || true
                    docker run -d --name ${APP_NAME} --restart unless-stopped -p ${HOST_PORT}:${CONTAINER_PORT} ${APP_NAME}:latest
                """
            }
        }
        // stage('Health Check') { 
        //     steps {
        //         sh '''
        //         sleep 5
        //         curl --fail http://color-dot:5000

        //         '''
        //     }
        // }

    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
   

}